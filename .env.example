# FinPulse Agent - Environment Variables

# SoSoValue API Key (get from https://sosovalue.xyz → API docs)
VITE_SOSOVALUE_API_KEY=YOUR_SOSOVALUE_API_KEY_HERE

# Google Gemini API Key (get from https://aistudio.google.com)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Server port for the API proxy
PORT=3001

# SoDEX network for order pricing / risk checks: testnet (default) or mainnet
SODEX_NETWORK=testnet

# Optional: Telegram bot (/signals, /score BTC, /track)
TELEGRAM_BOT_TOKEN=
